<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:text="Subject Hub"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:gravity="center"
        android:text="Find and explore your subjects"
        android:textColor="#9E9E9E"
        android:textSize="14sp" />

    <!-- Semester -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Select Semester"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/semesterSpinner"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="18dp"
        android:background="#242424"
        android:paddingStart="15dp"
        android:paddingEnd="15dp" />

    <!-- Search -->
    <EditText
        android:id="@+id/searchSubject"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="22dp"
        android:background="#242424"
        android:hint="🔍  Search subject..."
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <!-- Subject Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Available Subjects"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Subject List -->
    <ListView
        android:id="@+id/subjectListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#242424"
        android:divider="#3A3A3A"
        android:dividerHeight="1dp"
        android:padding="5dp" />

</LinearLayout>